<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cubase.Macro.Mobile.Lyrics.LyricViewer"
             Shell.BackgroundColor="#121212"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.NavBarHasShadow="True"
             Title="Lyrics">

    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="Auto, *" x:Name="MainGrid">

        <Border Grid.Row="1" Grid.Column="0"
                x:Name="FilesBorder"
                BackgroundColor="#1E1E1E"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                Stroke="LightGray"
                InputTransparent="False"
                ZIndex="100"
                StrokeThickness="1"
                WidthRequest="300">
            <!--<Border.Resources>
                <ResourceDictionary>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="White" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="TextColor" Value="White" />
                    </Style>
                </ResourceDictionary>
            </Border.Resources>-->

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,4,4,0" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Gray" Offset="0,0" Radius="10" Opacity="0.2" />
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout Padding="5" x:Name="LyricMenuLoader">
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Grid 
           BackgroundColor="#2A2A2A"
           Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
           HeightRequest="40">
            <HorizontalStackLayout x:Name="Menu" />
        </Grid>

        <ScrollView x:Name="LyricScrollView" Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout x:Name="LyricContainer" Padding="0,20" HorizontalOptions="Fill">

            </VerticalStackLayout>

        </ScrollView>

        <Grid 
           Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
           HeightRequest="40"
           BackgroundColor= "#2A2A2A"
           x:Name="BottomMenu">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <HorizontalStackLayout Grid.Column="0" x:Name="SetListButtons" IsVisible="False" Spacing="5" Margin="10,0,0,0" VerticalOptions="Center">
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="5" Margin="0,0,10,0" HorizontalOptions="End" VerticalOptions="Center">
                <Label Text="Duration: " VerticalOptions="Center" TextColor="White" />
                <Label x:Name="SongTime" VerticalOptions="Center" TextColor="White" Margin="5,0" />
                <Label Text="Bar/Time: " VerticalOptions="Center" TextColor="White" />
                <Label x:Name="CurrentBar" VerticalOptions="Center" TextColor="White" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>